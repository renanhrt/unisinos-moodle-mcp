{
  "name": "unisinos-moodle-mcp",
  "version": "0.7.0",
  "description": "Servidor MCP (Model Context Protocol) para o Moodle da Unisinos: use o Claude para ver prazos, notas, materiais, entregar tarefas, fóruns, mensagens e questionários.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "moodle",
    "unisinos",
    "claude",
    "claude-desktop"
  ],
  "author": "Renan Hardt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanhrt/unisinos-moodle-mcp.git"
  },
  "homepage": "https://github.com/renanhrt/unisinos-moodle-mcp#readme",
  "bugs": {
    "url": "https://github.com/renanhrt/unisinos-moodle-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "unisinos-moodle-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "login": "tsx src/auth/login-cli.ts",
    "whoami": "tsx src/auth/whoami-cli.ts",
    "test": "node --import tsx --test test/client.test.ts test/format.test.ts test/launch-token.test.ts test/files.test.ts test/server.test.ts test/submit.test.ts test/forums-messages.test.ts test/quiz.test.ts test/auth.test.ts test/updates.test.ts",
    "prepublishOnly": "npm run build && npm test",
    "pack:mcpb": "node scripts/build-mcpb.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "fflate": "^0.8.3",
    "node-html-parser": "^9.0.7",
    "playwright-core": "^1.65.1",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
